#!/bin/sh

# Inicializador Gradle Wrapper para Linux/macOS.
# O JAR e as propriedades do wrapper ficam em android_app/gradle/wrapper.

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" >/dev/null 2>&1 && pwd -P)
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ -n "$JAVA_HOME" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

if [ ! -x "$JAVACMD" ] && [ "$JAVACMD" != "java" ]; then
    echo "JAVA_HOME não aponta para uma instalação válida do Java: $JAVA_HOME" >&2
    exit 1
fi

exec "$JAVACMD" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
